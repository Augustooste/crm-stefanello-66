{
  "name": "tanstack_start_ts",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "lint": "oxlint && eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check scripts src",
    "gen:agent-platform": "node scripts/gen-agent-platform-contract.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || exit 0",
    "lint:erro-descartado": "node scripts/lint-erro-descartado.mjs",
    "test:functions": "deno test --allow-env --allow-read --allow-import --allow-net --allow-run=python3 --coverage=coverage/deno supabase/functions/tests/",
    "test:db": "supabase db reset --local && supabase test db --local supabase/tests/database",
    "test:all": "pnpm test:coverage && pnpm test:functions && pnpm test:db",
    "test:full": "node scripts/run-full-suite.mjs",
    "test:e2e:controlled": "node scripts/run-controlled-e2e-matrix.mjs",
    "test:e2e": "playwright test",
    "paridade": "node scripts/paridade-status.mjs",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "ops:t15:inventory": "node scripts/t15-database-ops.mjs inventory",
    "ops:t15:backup": "node scripts/t15-database-ops.mjs backup",
    "preflight": "pnpm install --frozen-lockfile && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:full && pnpm build"
  },
