# Credenciais/URLs da suíte E2E (Playwright). Copie para .env.e2e e preencha.
# .env.e2e é gitignored — nunca commite valores reais.

E2E_BASE_URL=http://localhost:8080

# Usuário principal (workspace A, admin) — obrigatório; sem ele os specs
# autenticados são pulados e a suíte passa sem testar nada.
E2E_USER_EMAIL=
E2E_USER_PASSWORD=

# Opcionais — specs correspondentes são pulados se ausentes:
E2E_USER2_EMAIL=
E2E_USER2_PASSWORD=
E2E_NEW_USER_EMAIL=
E2E_NEW_USER_PASSWORD=

# Sobe o dev server automaticamente antes dos testes (opcional):
# E2E_START_SERVER=1
